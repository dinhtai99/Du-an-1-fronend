<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:layout_margin="8dp"
    android:background="@drawable/category_item_normal"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgDanhMuc"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_category_default"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:background="@drawable/category_bg_gradient_1"
        android:elevation="4dp"
        android:contentDescription="Danh mục" />

    <TextView
        android:id="@+id/txtTenDanhMuc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh mục"
        android:textSize="12sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="8dp"
        android:gravity="center" />
</LinearLayout>